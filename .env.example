# ============================================================
# EWU Advanced RAG
# ============================================================

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT=120

# Embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval
DENSE_TOP_K=20
BM25_TOP_K=20
FUSION_TOP_K=30
RERANK_TOP_K=6
FINAL_CONTEXT_TOP_K=8

# RRF
RRF_K=60

# Workflow limits
MAX_SUBQUERIES=5
MAX_RETRIEVAL_RETRIES=2
MAX_ANSWER_REGENERATIONS=1
MAX_CONVERSATION_EXCHANGES=6