# ============================================================
# EWU Bulletin RAG Chatbot -- environment overrides
# ============================================================
#
# Copy this file to .env. Every variable maps to a field on Settings in
# src/config/settings.py -- that file is the authority and carries the full
# reasoning behind each default; this is a guide to the knobs worth turning.
# Names are case-insensitive and there is no prefix.
#
# UNKNOWN VARIABLES ARE IGNORED SILENTLY (model_config uses extra="ignore"),
# so a typo or a stale name produces no error and no effect. If a change
# appears to do nothing, check the spelling against settings.py first.
#
# Everything is commented out except LLM_MODEL. Commented means "use the
# shipped default" -- which is what every number in PROGRESS.md was measured
# with. Read the docstring in settings.py before uncommenting anything under
# MEASURED VALUES.
#
# Paths (DATA_DIR, PDF_PATH, CHROMA_DIR, ...) are derived from the project
# root and are deliberately not listed here. Override them in settings.py if
# you genuinely need to relocate data.


# ============================================================
# TAKES EFFECT ON RESTART
# ============================================================

# ------------------------------------------------------------
# LLM
# ------------------------------------------------------------

# The identifier LM Studio shows for the loaded model. Matched by PREFIX, so
# "gemma-4-12b-it" also resolves "gemma-4-12b-it-qat".
LLM_MODEL=gemma-4-12b-it-qat

# Any OpenAI-compatible server works despite the client's name -- it only
# POSTs /chat/completions and GETs /models for the health check.
# Ollama: http://localhost:11434/v1
#LLM_BASE_URL=http://localhost:1234/v1

#LLM_TEMPERATURE=0.1

# Raised from 120s. Gemma 4 reasons before answering; with reasoning ON a RAG
# answer can spend ~4,600 completion tokens, which blew the old timeout on
# half of all questions.
#LLM_TIMEOUT=300

# Gemma 4 is a reasoning model. "none" turns that off and is the shipped
# value: this task is grounded extraction from five passages already in the
# prompt, so there is nothing to reason out, and reasoning costs 5-9x the
# latency. "low" and "minimal" are silently ignored by this model.
#
# Set "default" to omit the reasoning_effort field ENTIRELY. Use that for any
# non-Gemma model and for any server that rejects unknown parameters.
#LLM_REASONING_EFFORT=none

# Spend a second LLM call re-checking the answer against the full reranked
# pool. Off: the deterministic checks below already hit citation accuracy
# 1.000 and number fidelity 1.000 without it (PROGRESS.md, Session 8).
#LLM_VERIFICATION_ENABLED=False
#VERIFICATION_MAX_CHUNKS=15

# ------------------------------------------------------------
# Device
# ------------------------------------------------------------

# "cuda" | "cpu" | "auto". Applies to the BGE-M3 embedder and the
# cross-encoder -- NOT to the LLM, whose GPU use is LM Studio's own "GPU
# Offload" setting and is unaffected by anything in this repo.
#
# Phases 1-4 silently ran on the CPU because torch was the "+cpu" wheel and
# both models auto-detected. A rerank eval took 30-50 minutes instead of under
# a minute. REQUIRE_GPU=True makes that failure loud instead of slow.
#DEVICE=cuda
#REQUIRE_GPU=True

# ------------------------------------------------------------
# Retrieval and reranking
# ------------------------------------------------------------

#DENSE_TOP_K=30
#BM25_TOP_K=30
#FUSION_TOP_K=50
#RRF_K=60

#RERANKER_MODEL=BAAI/bge-reranker-v2-m3
#RERANK_MAX_LENGTH=1024
#RERANK_INCLUDE_BREADCRUMB=True

# ENFORCED, not advisory -- the old agent called rerank(top_k=None), so the
# reranker reordered 50 candidates and filtered none of them.
#RERANK_TOP_K=5

# Batch sizes are tuned for a 16GB card alongside LM Studio. Lower them if you
# load a larger model and hit OOM.
#EMBEDDING_ENCODE_BATCH_SIZE=64
#RERANK_BATCH_SIZE=32
#EMBEDDING_BATCH_SIZE=256

# Return each hit's parent section instead of the child chunk.
#PARENT_EXPANSION_ENABLED=False
#MAX_CONTEXT_UNITS=8

# ------------------------------------------------------------
# Grounding
# ------------------------------------------------------------

# Deterministic, no LLM: every cited page must be in the retrieved set and
# every number in the answer must appear in the evidence. The eval harness
# flips this to measure what the checks are worth; nothing else should.
#ANSWER_VALIDATION_ENABLED=True

# When the one regeneration still fails validation: abstain (True) or deliver
# with the violation recorded in the trace (False). True ships -- an invented
# fee is worse than a refusal in a document people act on.
#ABSTAIN_ON_FAILED_VALIDATION=True

# ------------------------------------------------------------
# Workflow limits
# ------------------------------------------------------------

#MAX_SUBQUERIES=5

# Raising this above 1 raises worst-case LLM calls per query. The regeneration
# carries the specific failure reason; a plain retry at temperature 0.0 just
# reproduces its own failure.
#MAX_ANSWER_REGENERATIONS=1
#MAX_CONVERSATION_EXCHANGES=6

# Persist every REPL turn's trace to data/traces; read back with
# eval/trace_metrics.py. Eval scripts build their own metrics and leave it off.
#TRACE_PERSIST_ENABLED=True


# ============================================================
# MEASURED VALUES -- do not change without re-running the eval
# ============================================================

# CALIBRATED, not guessed. 0.02 is NOT the value that maximises abstention
# accuracy on eval/dataset.jsonl (0.40 does) -- it is the value that survives
# real phrasing. The cross-encoder's absolute score tracks wording as much as
# relevance: the same correct page scores 0.9913 for bulletin-vocabulary
# phrasing and 0.0652 for "What is the grading scale?". dataset.jsonl was
# generated FROM the PDF, which makes it a sound retrieval benchmark and a
# biased calibration set for abstention.
#
#   threshold 0.02 -> keeps 11/12 answerable, catches 7/8 unanswerable
#   threshold 0.40 -> keeps  2/12 answerable, catches 7/8 unanswerable
#
# Re-run BOTH eval/calibrate_abstention.py AND eval/paraphrase_probe.py before
# changing this.
#ABSTENTION_THRESHOLD=0.02

# Fraction of the query's content terms that must appear in the selected
# chunks; 0.0 disables. Measured: no coverage floor catches even one extra
# unanswerable question, and anything above 0.5 only costs answerable ones
# (0.6 -> 9 false abstentions, 0.7 -> 18).
#GATE_MIN_COVERAGE=0.0

# "lexical" expands the BM25 query only, "both" also expands the dense query,
# "none" disables it. Measured: lexical wins. "both" costs page-nDCG@10
# 0.809 -> 0.723 -- a bi-encoder does not need synonyms and is diluted by them.
#QUERY_EXPANSION_MODE=lexical


# ============================================================
# REQUIRES A FULL INDEX REBUILD
# ============================================================
#
# Changing anything below invalidates data/indexes/. Re-run:
#   .\.venv\Scripts\python.exe scripts\build_ingestion.py
#   .\.venv\Scripts\python.exe scripts\build_chroma.py
#   .\.venv\Scripts\python.exe scripts\build_bm25.py
# then re-run eval/run_eval.py --rerank and record the numbers in PROGRESS.md.

# BGE-M3 has an 8192-token window, so nothing in this corpus is truncated.
# The previous all-MiniLM-L6-v2 capped at 256 tokens and silently dropped the
# tails of 58.6% of chunks. Any replacement must be checked against the
# truncation invariant in tests/ -- it is test-enforced.
#EMBEDDING_MODEL=BAAI/bge-m3
#EMBEDDING_MAX_SEQ_LENGTH=8192

# Keep the tokenizer matched to the embedder, or the token budget below stops
# meaning what it says.
#CHUNK_TOKENIZER=BAAI/bge-m3
#CHILD_TARGET_TOKENS=250
#CHILD_OVERLAP_TOKENS=40
#MIN_PARENT_CHARS=400
#MAX_PARENT_CHARS=6000

# Ingestion validation. The validator fails the build on violation rather than
# warning.
#MIN_CHUNK_CHARS=50
#NEAR_DUPLICATE_THRESHOLD=0.9
